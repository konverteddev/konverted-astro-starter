---
import Icon from "~/components/Icon/Icon.astro";
import { cx } from "~/features/style/utils";

// One option row: the box or dial, and the text that turns the whole row into a hit area. Shared by
// the standalone checkbox and by both group types, which own the label, the error and the name.
type Props = {
  type: "checkbox" | "radio";
  name: string;
  label: string;
  id?: string;
  value?: string;
  checked?: boolean;
  required?: boolean;
  disabled?: boolean;
  describedBy?: string;
  invalid?: boolean;
  class?: string;
};

const { type, name, label, id = name, value, checked, required, disabled, describedBy, invalid, class: className } = Astro.props;

// Keyboard focus is painted globally in global.css, so a local outline would double it up.
const CONTROL_CLASS =
  "peer size-20 shrink-0 cursor-[inherit] appearance-none border border-form-ink bg-white " +
  "transition-colors duration-200 ease-out motion-reduce:transition-none " +
  "checked:border-form-ink checked:bg-form-ink " +
  "group-hover/choice:border-form-accent checked:group-hover/choice:bg-form-accent " +
  "disabled:border-form-line disabled:bg-white disabled:checked:bg-form-line " +
  "group-data-invalid/field:border-danger";

// The mark rides on top of the control, so the whole box stays one native hit target.
const MARK_CLASS = "pointer-events-none absolute text-white opacity-0 transition-opacity peer-checked:opacity-100";
---

<label
  class={cx('group/choice flex w-fit items-center gap-12', disabled ? 'cursor-not-allowed' : 'cursor-pointer', className)}
>
  <span class="relative flex items-center justify-center">
    <input
      type={type}
      id={id}
      name={name}
      value={value}
      checked={checked}
      required={required}
      disabled={disabled}
      aria-describedby={describedBy}
      aria-invalid={invalid ? 'true' : undefined}
      data-field-control
      class={cx(CONTROL_CLASS, type === 'radio' ? 'rounded-full' : 'rounded-4')}
    />

    {
      type === 'radio' ? (
        <span class={cx(MARK_CLASS, 'size-6 rounded-full bg-current')} />
      ) : (
        <Icon name="check" class={cx(MARK_CLASS, 'size-12')} />
      )
    }
  </span>

  <span class={cx('text-body-10 font-semibold', disabled ? 'text-form-muted/60' : 'text-form-ink')}>{label}</span>
</label>
